DATABASE_URL="postgresql://user:password@localhost:5432/zezlab_marketing"

# Auth for cron endpoints (generate with: openssl rand -hex 32)
CRON_SECRET="change-me"

# SMTP — leave blank to use console stub in development
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="marketing@yourdomain.com"

# App URL (use port 3001 to avoid clash with the main zezlab server on 3000)
NEXT_PUBLIC_APP_URL="http://localhost:3001"
